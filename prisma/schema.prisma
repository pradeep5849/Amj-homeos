generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HOME_OWNER
  HOME_USER
}

enum HomeMembershipRole {
  OWNER
  MEMBER
}

enum DeviceProtocol {
  WIFI
  ZIGBEE
  TUYA
}

enum DeviceType {
  LIGHT
  SWITCH
  FAN
  SENSOR
  OTHER
}

enum OnboardingType {
  WIFI_BLE
  ZIGBEE_GATEWAY
  TUYA
  GATEWAY
}

enum OnboardingStatus {
  IDLE
  PERMISSION_REQUIRED
  BLUETOOTH_DISABLED
  SCANNING
  DEVICE_FOUND
  DEVICE_SELECTED
  PROVISIONING
  WAITING_FOR_NETWORK
  REGISTERING
  SUCCESS
  FAILED
  UNSUPPORTED
  NOT_CONFIGURED
  CANCELLED
  EXPIRED
}

enum ProvisioningProvider {
  WEB_BLUETOOTH
  GATEWAY
  TUYA
}

enum GatewayType {
  ZIGBEE
  TUYA
  MULTIPROTOCOL
}

enum GatewayConnectionType {
  WIFI
  ETHERNET
}

enum LogicalCommand {
  setPower
  setBrightness
  setSpeed
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL_FAILURE
  FAILED
}

enum AutomationTriggerType {
  MANUAL
  DEVICE_STATE
  SCHEDULE
  PRESENCE_HOME
  PRESENCE_AWAY
  EVERYONE_AWAY
  ANYONE_HOME
}

enum PresenceStatus {
  HOME
  AWAY
  UNKNOWN
}

enum PresenceSource {
  MANUAL
  GEOFENCE
  SYSTEM
}

enum PresenceEventType {
  ENTER
  EXIT
  LOCATION_SAMPLE
  MANUAL
}

enum MobilePlatform {
  ANDROID
  IOS
  WEB
}

enum PushProvider {
  FCM
  APNS
  WEB_PUSH
}

enum DeliveryChannel {
  IN_APP
  PUSH
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  NOT_CONFIGURED
  SKIPPED
}

enum TriggerOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
}

enum ScheduleType {
  ONCE
  DAILY
  WEEKLY
  SUNRISE
  SUNSET
}

enum TimerTargetType {
  DEVICE_COMMAND
  SCENE
}

enum TimerStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  DEVICE
  AUTOMATION
  SCENE
  SCHEDULE
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR
}

model User {
  id                         String                    @id @default(uuid()) @db.Uuid
  email                      String
  normalizedEmail            String                    @unique
  passwordHash               String
  name                       String
  role                       Role
  isActive                   Boolean                   @default(true)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  adminProfile               AdminProfile?
  homeOwnerProfile           HomeOwnerProfile?
  sessions                   Session[]
  homeMemberships            HomeMembership[]
  onboardingSessions         DeviceOnboardingSession[]
  scenesCreated              Scene[]                   @relation("SceneCreator")
  automationsCreated         Automation[]              @relation("AutomationCreator")
  sceneExecutions            SceneExecution[]
  timersCreated              Timer[]
  notifications              Notification[]
  notificationPreference     NotificationPreference?
  presences                  HomePresence[]
  presenceEvents             PresenceEvent[]
  mobileClients              MobileClient[]
  geofencesCreated           HomeGeofence[]
  presenceAutomationTriggers AutomationTrigger[]

  @@index([role, isActive])
}

model Home {
  id                   String                    @id @default(uuid()) @db.Uuid
  name                 String
  timezone             String
  isArchived           Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  memberships          HomeMembership[]
  rooms                Room[]
  devices              Device[]
  gateways             Gateway[]
  onboardingSessions   DeviceOnboardingSession[]
  scenes               Scene[]
  automations          Automation[]
  sceneExecutions      SceneExecution[]
  automationExecutions AutomationExecution[]
  timers               Timer[]
  notifications        Notification[]
  latitude             Float?
  longitude            Float?
  presences            HomePresence[]
  presenceEvents       PresenceEvent[]
  geofences            HomeGeofence[]

  @@index([isArchived])
}

model HomeMembership {
  id        String             @id @default(uuid()) @db.Uuid
  homeId    String             @db.Uuid
  userId    String             @db.Uuid
  role      HomeMembershipRole
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  home      Home               @relation(fields: [homeId], references: [id], onDelete: Restrict)
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([homeId, userId])
  @@index([userId, role])
}

model Room {
  id             String   @id @default(uuid()) @db.Uuid
  homeId         String   @db.Uuid
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  home           Home     @relation(fields: [homeId], references: [id], onDelete: Restrict)
  devices        Device[]

  @@unique([homeId, normalizedName])
  @@index([homeId])
}

model Device {
  id                         String                      @id @default(uuid()) @db.Uuid
  homeId                     String                      @db.Uuid
  roomId                     String?                     @db.Uuid
  name                       String
  deviceType                 DeviceType
  protocol                   DeviceProtocol
  manufacturer               String?
  model                      String?
  externalDeviceId           String?
  isOnline                   Boolean                     @default(false)
  lastSeenAt                 DateTime?
  capabilities               Json
  state                      Json
  isArchived                 Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  home                       Home                        @relation(fields: [homeId], references: [id], onDelete: Restrict)
  room                       Room?                       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  integrationIdentities      DeviceIntegrationIdentity[]
  sceneActions               SceneAction[]
  automationTriggers         AutomationTrigger[]
  automationActions          AutomationAction[]
  sceneActionExecutions      SceneActionExecution[]
  automationExecutions       AutomationExecution[]       @relation("TriggerDeviceExecutions")
  automationActionExecutions AutomationActionExecution[]
  timers                     Timer[]

  @@index([homeId, isArchived])
  @@index([roomId, isArchived])
}

model Gateway {
  id                String                @id @default(uuid()) @db.Uuid
  homeId            String                @db.Uuid
  name              String
  gatewayType       GatewayType
  manufacturer      String?
  model             String?
  externalGatewayId String?
  connectionType    GatewayConnectionType
  isOnline          Boolean               @default(false)
  lastSeenAt        DateTime?
  isArchived        Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  home              Home                  @relation(fields: [homeId], references: [id], onDelete: Restrict)

  @@index([homeId, isArchived])
}

model DeviceOnboardingSession {
  id                   String                @id @default(uuid()) @db.Uuid
  homeId               String                @db.Uuid
  roomId               String?               @db.Uuid
  initiatedByUserId    String                @db.Uuid
  onboardingType       OnboardingType
  protocol             DeviceProtocol
  status               OnboardingStatus      @default(IDLE)
  discoveredIdentifier String?
  provider             ProvisioningProvider?
  expiresAt            DateTime
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  home                 Home                  @relation(fields: [homeId], references: [id], onDelete: Restrict)
  initiatedBy          User                  @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  @@index([homeId, status])
  @@index([expiresAt])
}

model DeviceIntegrationIdentity {
  id         String               @id @default(uuid()) @db.Uuid
  deviceId   String               @db.Uuid
  provider   ProvisioningProvider
  externalId String
  metadata   Json?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  device     Device               @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@index([deviceId])
}

model AdminProfile {
  userId             String             @id @db.Uuid
  isDefaultAdmin     Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedHomeOwners HomeOwnerProfile[] @relation("AssignedAdmin")
}

model HomeOwnerProfile {
  userId          String       @id @db.Uuid
  assignedAdminId String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin   AdminProfile @relation("AssignedAdmin", fields: [assignedAdminId], references: [userId], onDelete: Restrict)

  @@index([assignedAdminId])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Scene {
  id              String           @id @default(uuid()) @db.Uuid
  homeId          String           @db.Uuid
  name            String
  normalizedName  String
  description     String?
  isEnabled       Boolean          @default(true)
  isArchived      Boolean          @default(false)
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  home            Home             @relation(fields: [homeId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("SceneCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  actions         SceneAction[]
  executions      SceneExecution[]
  timers          Timer[]

  @@unique([homeId, normalizedName])
  @@index([homeId, isArchived])
}

model SceneAction {
  id         String                 @id @default(uuid()) @db.Uuid
  sceneId    String                 @db.Uuid
  deviceId   String                 @db.Uuid
  command    LogicalCommand
  value      Json
  sortOrder  Int
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  scene      Scene                  @relation(fields: [sceneId], references: [id], onDelete: Restrict)
  device     Device                 @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  executions SceneActionExecution[]

  @@unique([sceneId, sortOrder])
  @@index([deviceId])
}

model SceneExecution {
  id                String                 @id @default(uuid()) @db.Uuid
  sceneId           String                 @db.Uuid
  homeId            String                 @db.Uuid
  initiatedByUserId String?                @db.Uuid
  status            ExecutionStatus        @default(PENDING)
  startedAt         DateTime               @default(now())
  completedAt       DateTime?
  errorSummary      String?
  scene             Scene                  @relation(fields: [sceneId], references: [id], onDelete: Restrict)
  home              Home                   @relation(fields: [homeId], references: [id], onDelete: Restrict)
  initiatedBy       User?                  @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  actionExecutions  SceneActionExecution[]

  @@index([sceneId, startedAt])
  @@index([homeId, startedAt])
}

model SceneActionExecution {
  id               String          @id @default(uuid()) @db.Uuid
  sceneExecutionId String          @db.Uuid
  sceneActionId    String          @db.Uuid
  deviceId         String          @db.Uuid
  status           ExecutionStatus
  error            String?
  createdAt        DateTime        @default(now())
  sceneExecution   SceneExecution  @relation(fields: [sceneExecutionId], references: [id], onDelete: Restrict)
  sceneAction      SceneAction     @relation(fields: [sceneActionId], references: [id], onDelete: Restrict)
  device           Device          @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([sceneExecutionId])
}

model Automation {
  id              String                @id @default(uuid()) @db.Uuid
  homeId          String                @db.Uuid
  name            String
  normalizedName  String
  description     String?
  isEnabled       Boolean               @default(true)
  isArchived      Boolean               @default(false)
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  home            Home                  @relation(fields: [homeId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("AutomationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  triggers        AutomationTrigger[]
  actions         AutomationAction[]
  executions      AutomationExecution[]
  schedules       AutomationSchedule[]

  @@unique([homeId, normalizedName])
  @@index([homeId, isArchived, isEnabled])
}

model AutomationTrigger {
  id           String                @id @default(uuid()) @db.Uuid
  automationId String                @db.Uuid
  triggerType  AutomationTriggerType
  deviceId     String?               @db.Uuid
  userId       String?               @db.Uuid
  capability   String?
  operator     TriggerOperator?
  value        Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  automation   Automation            @relation(fields: [automationId], references: [id], onDelete: Restrict)
  device       Device?               @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([automationId, triggerType])
  @@index([deviceId, capability])
}

model AutomationAction {
  id           String                      @id @default(uuid()) @db.Uuid
  automationId String                      @db.Uuid
  deviceId     String                      @db.Uuid
  command      LogicalCommand
  value        Json
  sortOrder    Int
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  automation   Automation                  @relation(fields: [automationId], references: [id], onDelete: Restrict)
  device       Device                      @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  executions   AutomationActionExecution[]

  @@unique([automationId, sortOrder])
  @@index([deviceId])
}

model AutomationExecution {
  id               String                      @id @default(uuid()) @db.Uuid
  automationId     String                      @db.Uuid
  homeId           String                      @db.Uuid
  triggerType      AutomationTriggerType
  triggerDeviceId  String?                     @db.Uuid
  status           ExecutionStatus             @default(PENDING)
  correlationId    String                      @db.Uuid
  chainDepth       Int                         @default(0)
  startedAt        DateTime                    @default(now())
  completedAt      DateTime?
  errorSummary     String?
  automation       Automation                  @relation(fields: [automationId], references: [id], onDelete: Restrict)
  home             Home                        @relation(fields: [homeId], references: [id], onDelete: Restrict)
  triggerDevice    Device?                     @relation("TriggerDeviceExecutions", fields: [triggerDeviceId], references: [id], onDelete: Restrict)
  actionExecutions AutomationActionExecution[]

  @@index([automationId, startedAt])
  @@index([correlationId])
}

model AutomationActionExecution {
  id                    String              @id @default(uuid()) @db.Uuid
  automationExecutionId String              @db.Uuid
  automationActionId    String              @db.Uuid
  deviceId              String              @db.Uuid
  status                ExecutionStatus
  error                 String?
  createdAt             DateTime            @default(now())
  automationExecution   AutomationExecution @relation(fields: [automationExecutionId], references: [id], onDelete: Restrict)
  automationAction      AutomationAction    @relation(fields: [automationActionId], references: [id], onDelete: Restrict)
  device                Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([automationExecutionId])
}

model AutomationSchedule {
  id               String       @id @default(uuid()) @db.Uuid
  automationId     String       @db.Uuid
  scheduleType     ScheduleType
  localTime        String?
  daysOfWeek       Json?
  offsetMinutes    Int?
  runAt            DateTime?
  timezoneSnapshot String
  isEnabled        Boolean      @default(true)
  nextRunAt        DateTime?
  lastRunAt        DateTime?
  claimedAt        DateTime?
  claimToken       String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  automation       Automation   @relation(fields: [automationId], references: [id], onDelete: Restrict)

  @@index([isEnabled, nextRunAt])
  @@index([claimedAt])
}

model Timer {
  id              String          @id @default(uuid()) @db.Uuid
  homeId          String          @db.Uuid
  createdByUserId String          @db.Uuid
  targetType      TimerTargetType
  deviceId        String?         @db.Uuid
  sceneId         String?         @db.Uuid
  command         LogicalCommand?
  value           Json?
  runAt           DateTime
  status          TimerStatus     @default(PENDING)
  claimedAt       DateTime?
  claimToken      String?         @db.Uuid
  createdAt       DateTime        @default(now())
  executedAt      DateTime?
  cancelledAt     DateTime?
  errorSummary    String?
  home            Home            @relation(fields: [homeId], references: [id], onDelete: Restrict)
  createdBy       User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  device          Device?         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  scene           Scene?          @relation(fields: [sceneId], references: [id], onDelete: Restrict)

  @@index([status, runAt])
  @@index([claimedAt])
  @@index([homeId, status])
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String                 @db.Uuid
  homeId     String?                @db.Uuid
  type       NotificationType
  title      String
  body       String
  severity   NotificationSeverity   @default(INFO)
  isRead     Boolean                @default(false)
  createdAt  DateTime               @default(now())
  readAt     DateTime?
  metadata   Json?
  user       User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  home       Home?                  @relation(fields: [homeId], references: [id], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@index([userId, isRead, createdAt])
  @@index([homeId, createdAt])
}

model NotificationPreference {
  userId                  String   @id @db.Uuid
  inAppEnabled            Boolean  @default(true)
  deviceEventsEnabled     Boolean  @default(true)
  automationEventsEnabled Boolean  @default(true)
  scheduleEventsEnabled   Boolean  @default(true)
  systemEventsEnabled     Boolean  @default(true)
  pushEnabled             Boolean  @default(false)
  presenceEventsEnabled   Boolean  @default(true)
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HomePresence {
  id             String         @id @default(uuid()) @db.Uuid
  homeId         String         @db.Uuid
  userId         String         @db.Uuid
  status         PresenceStatus @default(UNKNOWN)
  source         PresenceSource @default(SYSTEM)
  lastChangedAt  DateTime       @default(now())
  lastReportedAt DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  home           Home           @relation(fields: [homeId], references: [id], onDelete: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([homeId, userId])
  @@index([homeId, status])
}

model HomeGeofence {
  id              String   @id @default(uuid()) @db.Uuid
  homeId          String   @db.Uuid
  name            String
  latitude        Float
  longitude       Float
  radiusMeters    Int
  isEnabled       Boolean  @default(true)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  home            Home     @relation(fields: [homeId], references: [id], onDelete: Restrict)
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([homeId, isEnabled])
}

model MobileClient {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @db.Uuid
  clientInstanceId   String
  platform           MobilePlatform
  appVersion         String?
  deviceLabel        String?
  pushProvider       PushProvider?
  pushTokenEncrypted String?
  isActive           Boolean                @default(true)
  lastSeenAt         DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  events             PresenceEvent[]
  deliveries         NotificationDelivery[]

  @@unique([userId, clientInstanceId])
  @@index([userId, isActive])
}

model PresenceEvent {
  id             String            @id @default(uuid()) @db.Uuid
  homeId         String            @db.Uuid
  userId         String            @db.Uuid
  mobileClientId String?           @db.Uuid
  eventId        String?
  previousStatus PresenceStatus
  newStatus      PresenceStatus
  source         PresenceSource
  eventType      PresenceEventType
  occurredAt     DateTime
  receivedAt     DateTime          @default(now())
  accuracyMeters Float?
  distanceBand   String?
  correlationId  String?           @db.Uuid
  home           Home              @relation(fields: [homeId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  mobileClient   MobileClient?     @relation(fields: [mobileClientId], references: [id], onDelete: Restrict)

  @@unique([mobileClientId, eventId])
  @@index([homeId, userId, occurredAt])
}

model NotificationDelivery {
  id             String          @id @default(uuid()) @db.Uuid
  notificationId String          @db.Uuid
  mobileClientId String          @db.Uuid
  channel        DeliveryChannel
  status         DeliveryStatus
  provider       PushProvider?
  attemptedAt    DateTime        @default(now())
  deliveredAt    DateTime?
  errorCode      String?
  notification   Notification    @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  mobileClient   MobileClient    @relation(fields: [mobileClientId], references: [id], onDelete: Restrict)

  @@index([status, attemptedAt])
  @@index([notificationId])
}
